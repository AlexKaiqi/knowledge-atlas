{
  "name": "knowledge-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run validate && npm test && npm run build && npm run check:links",
    "check:links": "node scripts/check-links.mjs",
    "serve": "node scripts/serve.mjs",
    "scaffold:case": "node scripts/scaffold-case.mjs",
    "scaffold:knowledge": "node scripts/scaffold-knowledge.mjs",
    "promote:case": "node scripts/promote-case.mjs",
    "publish:knowledge": "node scripts/publish-knowledge.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "motion": "13.2.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
