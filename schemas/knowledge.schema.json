{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Atlas knowledge object",
  "type": "object",
  "required": ["id", "status", "title", "titleZh", "epistemicType", "summary", "statement", "assumptions", "doesNotImply", "engineeringImplications", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "status": {"enum": ["draft", "published", "archived"]},
    "epistemicType": {"type": "string"},
    "formula": {"type": "string"},
    "assumptions": {"type": "array", "minItems": 1},
    "doesNotImply": {"type": "array", "minItems": 1},
    "engineeringImplications": {"type": "array"},
    "sources": {"type": "array"}
  }
}
